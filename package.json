{
  "name": "voice-ai-copilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @copilot/api\" \"npm run dev -w @copilot/web\"",
    "dev:api": "npm run dev -w @copilot/api",
    "dev:web": "npm run dev -w @copilot/web",
    "build": "npm run build -w @copilot/web",
    "start": "NODE_ENV=production npm run start -w @copilot/api",
    "start:prod": "npm run build && npm run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
