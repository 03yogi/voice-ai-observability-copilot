# Copy to .env — only server port is required for local dev.
# GHL and LLM credentials are configured in the app UI (Settings menu).

PORT=3001

# Production / GHL iframe deploy:
# NODE_ENV=production   (set automatically by npm run start)
# APP_URL=https://your-public-url.example.com
# SERVE_WEB=true        (optional in dev: serve built UI from API on PORT)

# Optional fallbacks if you prefer env over UI (not required):
# GHL_API_TOKEN=
# GHL_LOCATION_ID=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=
